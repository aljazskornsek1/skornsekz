{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "outputs",
  "functions": {
    "api/analiza.js": { "maxDuration": 60 },
    "api/portfelj.js": { "maxDuration": 60 },
    "api/skoda.js": { "maxDuration": 60 },
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/pregled_police.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 6 * * *"
    }
  ]
}

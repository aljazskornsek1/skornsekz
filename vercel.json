{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "outputs",
  "functions": {
    "api/analiza.js": { "maxDuration": 60 },
    "api/portfelj.js": { "maxDuration": 60 },
    "api/skoda.js": { "maxDuration": 60 },
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/pregled_police.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 6 * * *"
    }
  ]
}
